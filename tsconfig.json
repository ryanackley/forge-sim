{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "//exclude": "src/bridge/hosts/browser is DOM code bundled by esbuild (scripts/build-bridge-bundle.mjs) and type-checked by tsconfig.bridge-browser.json. The root project is lib: ES2022 only, so it must not sweep it in.",
  "exclude": ["node_modules", "dist", "src/__tests__", "src/bridge/hosts/browser"]
}
